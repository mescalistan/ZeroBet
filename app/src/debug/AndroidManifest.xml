<?xml version="1.0" encoding="utf-8"?>
<!-- Solo build di debug: hook per le prove strumentate (vedi DebugTestReceiver).
     Il permesso DUMP lo limita alla shell adb e al sistema. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugTestReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zerobet.safeguard.debug.SET_PIN" />
                <action android:name="com.zerobet.safeguard.debug.SIM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
